# Repository-wide ignores. Anything specific to one of the two apps lives in
# that app's own .gitignore (pebble/.gitignore, flutter/.gitignore).

# Key material. `just check-secrets` enforces that none of it reaches a file
# here, but an accidentally-placed key file must not be committable either.
*.apikey

# Agent and editor state
.claude/
.serena/
.cursor/
.idea/
*.iml
.vscode/

# Logs
*.log
